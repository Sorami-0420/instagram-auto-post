# このファイルをコピーして .env を作り、実際の値を入れてください(.envはgitに含めません)
# cp .env.example .env

# Google Cloudのサービスアカウントキー(JSONファイルの中身をそのまま1行で貼り付け)
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "...": "..."}

# GoogleスプレッドシートのID(URLの https://docs.google.com/spreadsheets/d/【ここ】/edit 部分)
SPREADSHEET_ID=

# シート(タブ)名
SHEET_NAME=投稿管理

# Anthropic (Claude) APIキー
ANTHROPIC_API_KEY=

# Instagram Graph API (本番投稿時のみ必須。テストモードでは空でOK)
IG_USER_ID=
IG_ACCESS_TOKEN=

# 画像の公開URLのベース(ローカルテスト用。GitHub Actions上では自動設定されるので空でよい)
# 例: https://raw.githubusercontent.com/ユーザー名/リポジトリ名/main/posts
IMAGE_BASE_URL=

# true = 投稿せずキャプション確認のみ / false = 実際に投稿する
TEST_MODE=true
